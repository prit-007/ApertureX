# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Container-local pub cache (tool/ci runs and local docker runs of the
# F-Droid buildserver image use a workspace-local PUB_CACHE)
.pub-cache/

# Rust
app/rust/target/

# Vendored Rust crates (generated by tool/ci/rust_vendor.sh for the offline
# F-Droid builder — committed only for a release that ships to F-Droid,
# via `git add -f`; see docs/fdroid-metadata.yml)
app/rust/vendor/
app/rust/.cargo/

# IDE
.idea/
*.iml
.vscode/

# Python tooling
__pycache__/
*.pyc

# OS
.DS_Store

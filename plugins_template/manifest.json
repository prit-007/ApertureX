{
  "plugin_id": "com.community.cinematic_depth_blur",
  "name": "Cinematic Optical Depth Blur",
  "author": "Community / ApertureX Neural Forge",
  "version": "1.0.0",
  "description": "On-device monocular depth estimation and optical lens bokeh simulator.",
  "task": "depthEstimation",
  "source_url": "https://github.com/prit-007/ApertureX",
  "model_file": "model.onnx",
  "input_shape": [1, 3, 512, 512],
  "output_shape": [1, 1, 512, 512],
  "controls": [
    {
      "id": "blur_amount",
      "label": "Bokeh Intensity",
      "type": "slider",
      "min": 0.0,
      "max": 100.0,
      "default": 35.0
    },
    {
      "id": "focal_plane",
      "label": "Focal Distance",
      "type": "slider",
      "min": 0.0,
      "max": 1.0,
      "default": 0.40
    },
    {
      "id": "aperture_blades",
      "label": "Aperture Blades",
      "type": "slider",
      "min": 0.0,
      "max": 9.0,
      "default": 7.0
    }
  ]
}
